from __future__ import annotations

# 每章資料都直接對應《簡易教科書內容製作規格》的章節元素。
# 文字刻意保持制度與理論本位；快速變動的利率、準備率與單月貨幣數據不寫死。
CHAPTERS = [
{
'id':'ch00','title':'貨幣銀行學的分析地圖','slug':'money-map',
'problem':'貨幣、金融市場、銀行與中央銀行看似是四個主題，其實它們共同回答同一件事：資金如何移轉、信用如何形成，以及政策如何透過金融體系影響支出、物價與風險。',
'intuition':['把經濟想成一套支付與信用網路。家戶持有貨幣、存款與金融資產；企業與政府需要融資；銀行與市場把資金由有餘額者導向需要資金者；中央銀行則提供最終清算資產並影響短期金融條件。','本書的讀法不是背機構名稱，而是每遇到一個事件就追四步：誰的資產負債表改變、哪個價格或利率改變、哪個支出決策受影響、最後風險由誰承擔。'],
'definitions':[('貨幣（money）','能廣泛充當交易媒介、計價單位與價值儲藏的資產。'),('信用（credit）','現在取得資源、承諾未來償付的契約關係。'),('金融市場（financial market）','資金需求者與供給者透過可交易金融工具直接連結的制度。'),('金融中介（financial intermediary）','以自身資產負債表介入資金移轉，例如銀行吸收存款並持有放款。'),('中央銀行（central bank）','發行基礎貨幣、提供最終清算與執行貨幣政策的公共機構。')],
'formulas':[('資產=負債+權益','所有金融機構題目的第一個檢查式；每一筆交易都要能回到資產負債表恆等。'),('名目量=價格水準\times實質量','後面討論貨幣、物價與實質購買力時的基本拆解。')],
'example':['例：家戶把 NT$100,000 現金存入銀行。對家戶而言，資產只是由現金改成存款；對銀行而言，準備或現金資產增加，同時存款負債增加。','若銀行之後把部分資金轉成放款，銀行資產組成再改變；借款人若取得新存款，支付體系與信用總量也會跟著變。','解題時不要只問「錢去哪裡」，而要分別列出家戶、銀行與中央銀行可能變動的資產與負債。'],
'traps':['把「貨幣」等同所有財富；股票、房屋很有價值，但不一定屬於貨幣總計數。','看到央行增加準備貨幣，就直接斷言銀行貸款與 M2 必定同比例增加。','只看單一銀行而忽略跨行支付與中央銀行清算。'],
'exam':['先辨認題目在問存量還是流量。','畫最少必要的資產負債表，再判斷利率、價格與支出。','政策題最後一定補一句成立條件，不把方向性結論寫成無條件必然。'],
'checks':['為何同一筆存款交易對家戶與銀行會出現不同會計位置？','中央銀行為何和一般商業銀行不同？','「信用增加」是否必然等於「現金增加」？為什麼？'],
'figure':('貨幣銀行學四層傳導圖',['貨幣與支付','市場與利率','銀行與信用','央行與政策'])
},
{
'id':'ch01','title':'貨幣、支付與貨幣總計數','slug':'money-aggregates',
'problem':'什麼東西算貨幣？M1A、M1B、M2 為何不同？判斷關鍵不是帳戶名稱，而是資產能多快、以多低成本轉成支付手段。',
'intuition':['貨幣首先是支付技術。現金流動性最高；活期性存款可以迅速支付；某些定期性資產雖不直接拿來買東西，但很容易轉成交易性餘額，因此會進入較廣義的貨幣口徑。','台灣常見 M1A、M1B、M2 是由窄到廣的貨幣總計數。考試重點是理解其流動性層級與包含關係，不背某個月份的數字。支付工具的創新會改變使用方式，但不等於每種電子記錄都自動成為央行定義的貨幣。'],
'definitions':[('交易媒介','買賣雙方普遍接受，用來完成交換的功能。'),('計價單位','用共同單位標示價格與債務，使不同商品可以比較。'),('價值儲藏','把購買力由現在移到未來；通膨會侵蝕貨幣的實質購買力。'),('流動性','資產能迅速、低成本且價值損失很小地轉成支付手段的程度。'),('M1A／M1B／M2','台灣中央銀行使用的貨幣總計數；由較窄的交易性貨幣逐步擴至較廣義流動資產。')],
'formulas':[('M1A\subset M1B\subset M2','表示由窄到廣的概念包含關係；實際組成以中央銀行最新統計定義為準。'),('實質貨幣餘額=M/P','名目貨幣餘額 M 除以價格水準 P，才代表可購買的實質商品量。')],
'example':['若某人的薪資存入可直接轉帳支付的帳戶，這筆資產具有高度交易性；若改放入到期前有較高轉換成本的存款，流動性下降但仍可能屬較廣義貨幣。','題目若問 M2 增加是否代表每個人現金都增加，答案是否定的：M2 的變化可能來自不同存款類別與資產轉換。','判斷貨幣口徑時先看官方定義，再看資產的支付便利性，而不是憑產品名稱猜。'],
'traps':['把信用卡額度當成既有貨幣存量；信用卡首先是支付與信用安排。','把 M2 當成社會全部金融資產。','把電子支付工具本身和其背後的存款或貨幣資產混為一談。'],
'exam':['先排序流動性，再判斷窄義或廣義貨幣。','遇到台灣制度題，以央行最新口徑為準，不背已過期數值。','名目金額與實質購買力分開，看到物價就考慮 M/P。'],
'checks':['交易媒介與價值儲藏是否必須由同一種資產做到最好？','為何 M2 比 M1B 廣？','物價上升而名目貨幣不變時，實質貨幣餘額如何變？'],
'figure':('貨幣總計數與流動性階梯',['現金／交易餘額','M1A','M1B','M2'])
},
{
'id':'ch02','title':'現值、利率與債券定價','slug':'bond-pricing',
'problem':'利率是跨期價格。要比較今天與未來的金額，必須先折到同一時間點；債券價格與到期殖利率也由同一套現值邏輯連起來。',
'intuition':['今天的 NT$1 與一年後的 NT$1 不等值，因為今天的資金可以投資、也具有流動性。利率因此是把不同時間點金額換成可比較單位的折現率。','債券是一串未來承諾現金流。市場要求報酬率上升時，同一串現金流必須以更高折現率折現，所以現在價格下降；這就是債券價格與利率反向關係。'],
'definitions':[('現值（present value）','把未來現金流依市場要求報酬率折回今天的價值。'),('未來值（future value）','今天金額按給定利率累積到未來的價值。'),('票面利率','票息相對票面金額的契約比例，不等於市場要求報酬率。'),('到期殖利率（YTM）','使債券承諾現金流的現值等於目前市場價格的折現率。'),('持有期間報酬率','實際持有期間收到的現金流與價格變動合計，相對初始投資的報酬。')],
'formulas':[('PV=FV/(1+i)^n','i 為每期折現率，n 為期數；期間與利率單位要一致。'),('FV=PV(1+i)^n','複利累積公式。'),('P_B=\sum_{t=1}^{n}C/(1+y)^t+F/(1+y)^n','固定息債券價格；C 為票息、F 為面額、y 為每期 YTM。'),('(1+i)=(1+r)(1+\pi^e)','名目利率、實質利率與預期通膨的精確 Fisher 關係。')],
'example':['標準例題：一年後確定收到 NT$10,500，市場一年期利率為 5%。現值 = 10,500/1.05 = NT$10,000。','若 NT$100,000 以年利率 4% 複利兩年，未來值 = 100,000×1.04² = NT$108,160。','債券題先列現金流時間點，再決定折現率；不要看到票面利率就直接把它當 YTM。'],
'traps':['把票面利率、當期收益率、YTM 與持有期間報酬率視為同一數字。','期數用月、利率卻仍用年利率而未換算。','利率上升時誤判固定現金流債券價格也上升。'],
'exam':['先畫時間軸再折現。','比較兩種利率前先確認都是每期或年化口徑。','YTM 題先用「價格＝現金流現值」辨認，而不是背價格方向。'],
'checks':['利率由 4% 升到 6% 時，同一筆一年後現金流的現值如何變？','折價債券的市場 YTM 與票面利率通常誰較高？','持有到期前若市場利率改變，實際持有期間報酬是否一定等於原 YTM？'],
'figure':('債券現金流與折現',['今天價格','票息現值','本金現值','到期現金流'])
},
{
'id':'ch03','title':'利率風險、存續期間與殖利率曲線','slug':'yield-curve',
'problem':'同樣是債券，為何長天期通常更怕利率變動？殖利率曲線又如何把市場對未來短率與期限溢酬的看法放在同一張圖上？',
'intuition':['債券現金流越晚收到，折現率變動造成的現值變化通常越大。存續期間把現金流的時間分布濃縮成利率敏感度指標。','殖利率曲線比較同類信用風險下不同到期期限的殖利率。它同時受未來短期利率預期與期限溢酬影響，因此反轉可以是景氣訊號，但不是衰退的機械定律。'],
'definitions':[('Macaulay 存續期間','以各期現金流現值占價格的權重計算加權平均收款時間。'),('修正存續期間','把 Macaulay duration 轉成價格對殖利率小幅變動的一階敏感度。'),('殖利率曲線','同一時點、可比較信用條件下，不同期限利率或殖利率的關係。'),('預期理論','長率反映未來短率預期的理論基準。'),('期限溢酬','投資人承擔較長期限利率與流動性風險可能要求的額外報酬。')],
'formulas':[('\Delta P/P\approx-D_{mod}\Delta y','只是一階近似，最適合小幅、近似平行的殖利率變動。'),('長期利率\approx未來短期利率平均+期限溢酬','概念式；期限溢酬可隨時間改變。')],
'example':['若修正存續期間為 5，殖利率上升 0.5 個百分點，即 Δy=0.005，則價格百分比變動約為 -5×0.005=-2.5%。','這是小幅變動近似；若利率變動很大，凸性會使實際價格曲線偏離直線近似。','看殖利率曲線題時，先分「未來短率預期」與「期限溢酬」兩部分，不要把曲線形狀只歸因一個原因。'],
'traps':['把存續期間當成所有債券精確的到期年數。','用一階 duration 近似處理非常大的殖利率跳動而不提凸性誤差。','宣稱殖利率曲線反轉必然造成或必然預告衰退。'],
'exam':['利率風險題先看期限、票息與殖利率，再用 duration 判斷方向與近似幅度。','期限結構題先確認信用風險是否可比較。','曲線反轉題用「預期＋期限溢酬」語言回答最穩健。'],
'checks':['兩張同面額債券中，其他條件相同時，零息長債與高票息短債誰通常 duration 較長？','殖利率曲線向上是否能證明未來短率一定上升？','為何大幅利率變動時要考慮凸性？'],
'figure':('殖利率曲線的兩個來源',['短率預期','期限溢酬','長期殖利率','曲線形狀'])
},
{
'id':'ch04','title':'金融市場與主要金融工具','slug':'financial-markets',
'problem':'企業、政府與家戶為何有時透過市場直接融資，有時透過銀行間接融資？貨幣市場、債券市場與股票市場又各自解決什麼需求？',
'intuition':['直接金融讓資金需求者直接發行證券給投資人；間接金融則由銀行等中介先向資金供給者負債，再持有對借款人的債權。兩種方式在資訊、流動性、規模與風險分攤上各有優勢。','貨幣市場偏短期流動性與資金調度；債券市場提供較長期固定收益融資；股票代表剩餘請求權。考題常把「工具的期限」與「交易市場是一級或次級」混在一起。'],
'definitions':[('直接金融','借款人直接向最終資金供給者發行證券。'),('間接金融','金融中介以自己的負債向資金供給者籌資，再形成放款或其他資產。'),('一級市場','新證券首次發行、資金直接流向發行者的市場。'),('次級市場','既有證券在投資人間轉手，提升流動性與價格發現。'),('貨幣市場','以短期、高流動性債務工具為主的市場。')],
'formulas':[('總報酬率=(現金收入+價格變動)/期初價格','適用於比較持有期間投資報酬；現金收入依工具可能是利息、股利等。'),('債權價值+剩餘權益=企業資產價值','概念式，用來分辨債券與股票的請求權順位。')],
'example':['公司新發行公司債取得 NT$1 億，這筆融資發生在一級市場；之後投資人把該債券賣給另一位投資人，是次級市場交易。','次級市場交易通常不會再次把成交款直接交給原公司，但提高證券流動性可降低投資人要求的流動性補償。','銀行放款則屬典型間接金融：存款人不是直接持有每位借款人的借據。'],
'traps':['把次級市場交易誤認為發行公司每次都收到新資金。','把所有一年以下工具都叫存款；貨幣市場包含多種短期證券。','把股票股利當成契約上保證支付的票息。'],
'exam':['先分直接／間接，再分一級／次級。','判斷工具先看請求權、期限與現金流是否契約固定。','流動性題要分「容易轉手」與「沒有價格風險」。兩者不是同義。'],
'checks':['為何活絡的次級市場可能幫助一級市場發行？','銀行放款屬直接金融還是間接金融？','股票與債券在清償順位上有何差異？'],
'figure':('資金移轉的兩條路',['資金供給者','直接金融市場','金融中介','資金需求者'])
},
{
'id':'ch05','title':'金融中介與資訊不對稱','slug':'financial-intermediation',
'problem':'如果借貸雙方可以直接簽約，為何銀行與其他金融中介仍然存在？核心理由是交易成本、資訊生產與契約執行。',
'intuition':['借款人通常比出資人更了解自己的風險與行為。放款前，高風險借款人可能更積極尋求資金，形成逆選擇；放款後，借款人可能採取讓債權人更危險的行為，形成道德危險。','中介透過規模經濟、審查、監督、擔保、契約限制與風險分散降低資訊成本。但中介本身也可能產生代理問題，因此監理與資本要求仍有必要。'],
'definitions':[('資訊不對稱','交易一方掌握另一方難以觀察的重要資訊。'),('逆選擇','契約成立前，風險較高者更可能進入交易，使平均品質惡化。'),('道德危險','契約成立後，行為不可完全觀察，當事人因風險分攤而改變行為。'),('委託監督','投資人把蒐集資訊與監督借款人的工作交由專業中介完成。'),('抵押品','借款人提供可被債權人求償的資產，以降低違約誘因與損失。')],
'formulas':[('預期信用損失\approx違約機率\times違約損失率\times曝險額','只是風險直覺，不進入銀行內部模型或監理計量細節。'),('放款利率\approx基準資金成本+信用風險溢酬+其他成本','概念式；不同借款人與契約的風險溢酬可能不同。')],
'example':['若銀行只用單一利率、不做任何審查，高風險借款人可能更願意接受高利率，這是逆選擇。','核貸後若借款人把資金改投更高風險計畫，而銀行難以觀察，則是道德危險。','提高自有資金、要求擔保品或設定契約條款都可能降低問題，但也會增加融資成本或排除部分借款人。'],
'traps':['把逆選擇與道德危險的時間點顛倒。','認為有抵押品就完全沒有信用風險。','認為金融中介只靠「把小額存款集合成大額放款」，忽略資訊與流動性服務。'],
'exam':['先問問題發生在契約前還是契約後。','再判斷對策是在改善篩選、監督、誘因還是損失承擔。','題目若提存款保險，還要檢查它是否改變銀行或存款人的風險誘因。'],
'checks':['借款前隱藏自身風險屬逆選擇還是道德危險？','擔保品如何同時影響銀行損失與借款人誘因？','為何中介能降低但不能消除資訊不對稱？'],
'figure':('資訊不對稱與中介功能',['契約前篩選','核貸','契約後監督','風險承擔'])
},
{
'id':'ch06','title':'銀行資產負債表與獲利','slug':'bank-balance-sheet',
'problem':'銀行不是把存款原封不動放在金庫。理解銀行先看資產負債表：資產如何賺取收益、負債如何提供資金、權益如何吸收損失。',
'intuition':['銀行資產通常包括準備、放款與證券；負債包括各類存款與市場融資；權益是資產扣除負債後的剩餘。資產報酬高不代表股東報酬一定低，因為槓桿會放大 ROE，也會放大損失。','銀行獲利除了利息收入減利息支出形成的淨利息收入，還可能有手續費等非利息收入。真正比較效率時要看資產規模、權益與風險，而非只看絕對盈餘。'],
'definitions':[('銀行資產','銀行對外的經濟資源，例如準備、放款與證券。'),('銀行負債','銀行對存款人或其他債權人的償付義務。'),('銀行權益','股東承擔的剩餘價值，是吸收損失的重要緩衝。'),('ROA','淨利相對平均資產的報酬率。'),('ROE','淨利相對平均權益的報酬率；高槓桿可放大正負結果。')],
'formulas':[('資產=負債+權益','銀行每筆交易都必須維持此恆等式。'),('ROA=淨利/平均資產','衡量資產產生獲利的效率。'),('ROE=淨利/平均權益','衡量股東資本報酬；需搭配槓桿與風險解讀。'),('淨利息收入=利息收入-利息支出','不等於最終淨利，因仍有信用損失與營運費用等。')],
'example':['標準例題：銀行資產 NT$1,000 億、負債 NT$920 億，則權益為 NT$80 億。','若淨利 NT$8 億，ROA=8/1000=0.8%，ROE=8/80=10%。','若利息收入 NT$80 億、利息支出 NT$50 億，淨利息收入為 NT$30 億；但不能直接把 30 億視為淨利。'],
'traps':['把存款列為銀行資產；對銀行而言存款是對客戶的負債。','只因 ROE 高就判斷銀行經營一定較安全或較有效率。','把淨利息收入與淨利混為同一項。'],
'exam':['任何銀行題先寫 A=L+E。','ROA、ROE 題先確認分母口徑與單位。','比較兩家銀行時，同時看獲利、槓桿、資產品質與流動性。'],
'checks':['銀行收到新存款時，資產與負債如何同時變動？','為何高槓桿會提高 ROE 對盈虧的敏感度？','淨利息收入為正是否保證淨利為正？'],
'figure':('銀行資產負債表',['準備與證券','放款資產','存款與融資','權益資本'])
},
{
'id':'ch07','title':'銀行風險與資產負債管理','slug':'bank-risk',
'problem':'銀行同時承擔流動性、信用、利率與資本風險。資產負債管理的核心不是消除所有風險，而是在收益、流動性與承受損失能力間取捨。',
'intuition':['銀行常用較短期、可提領的負債支持較長期放款，這種期限轉換提供經濟功能，也造成流動性與利率風險。若資產與負債重新訂價速度不同，市場利率變動會影響淨利息收入。','信用風險則來自借款人無法履約。準備與高流動資產可以應付提款，但持有過多也有機會成本；資本能吸收損失，但不是日常支付清算的同義詞。'],
'definitions':[('流動性風險','無法及時以合理成本履行付款或提款義務的風險。'),('信用風險','借款人或交易對手未依契約履行的風險。'),('利率風險','市場利率改變對銀行收入或資產負債經濟價值造成的不利影響。'),('重新訂價缺口（GAP）','一定期間內利率敏感資產 RSA 減利率敏感負債 RSL。'),('資本風險','損失侵蝕權益，使銀行接近監理或清償能力限制的風險。')],
'formulas':[('GAP=RSA-RSL','用於短期淨利息收入的簡化敏感度分析。'),('\Delta NII\approx GAP\times\Delta i','需假設利率變動能近似套用至該期間敏感資產與負債。')],
'example':['若一年內重新訂價資產 RSA=NT$300 億、負債 RSL=NT$500 億，GAP=-NT$200 億。','若相關利率普遍上升 1 個百分點，簡化估計 ΔNII≈-200×0.01=-NT$2 億。','這只是缺口近似；實務還有不同利率基準、非線性、提前還款與避險等，但大學入門先掌握方向。'],
'traps':['升息必然增加每一家銀行獲利。','把「資本充足」與「手上現金很多」當成同一件事。','只看平均到期日，不看資產與負債何時重新訂價。'],
'exam':['先分是流動性、信用、利率還是資本問題。','利率題先決定 GAP 正負，再乘利率方向。','遇到擠兌情境，先問資產是否有償付能力，再問短期是否能變現。'],
'checks':['負 GAP 銀行遇到利率上升時，簡化模型下 NII 方向如何？','為何持有更多流動資產可能降低收益？','資產有價值但短期賣不掉屬哪一類風險？'],
'figure':('銀行四類核心風險',['流動性','信用','利率','資本'])
},
{
'id':'ch08','title':'銀行監理、存款保險與金融危機','slug':'bank-safety-net',
'problem':'銀行為何受到比一般企業更多監理？因為高槓桿、短期負債、支付功能與相互連結，使單一機構問題可能外溢成系統性風險。',
'intuition':['資本要求讓股東先承擔更多損失；流動性要求降低短期資金中斷時被迫急售資產的機率；存款保險可降低小額存款人搶先提款的誘因。這些安全網同時可能降低市場紀律，形成道德危險。','最後貸款者處理的是急迫流動性問題，而不是把所有信用損失移給中央銀行。經典核心是對具還款能力但流動性不足、且難以從其他來源籌資的銀行提供緊急流動性。'],
'definitions':[('個體審慎監理','聚焦單一金融機構的資本、流動性、治理與風險管理。'),('總體審慎政策','聚焦全體金融體系共同曝險、順循環與系統性風險。'),('存款保險','在制度範圍內保障存款人，降低擠兌誘因的金融安全網。'),('最後貸款者','在適當條件下由中央銀行向具償付能力但暫時缺乏流動性的銀行提供緊急資金。'),('系統性風險','個別機構或市場衝擊經相互連結與共同曝險擴散，危及整體金融功能的風險。')],
'formulas':[('資本比率\approx權益/風險承擔基礎','入門用來理解資本緩衝；Basel 實際風險權數與監理定義更完整。'),('流動性緩衝\uparrow\Rightarrow短期擠兌脆弱性通常\downarrow','方向性關係，不表示可以消除所有銀行風險。')],
'example':['假設一家銀行的放款長期可收回，但今日大量存款人同時提款，銀行短期無法把資產變現。這首先是流動性危機。','若銀行資產實際價值已低於負債，則核心是清償能力問題；緊急流動性本身不能消除資產缺口。','Basel III 在本書只掌握資本、槓桿與 LCR／NSFR 等流動性要求的經濟意義，不背完整監理計算。'],
'traps':['存款保險可以消除所有銀行風險。','最後貸款者等於央行無條件救助任何資不抵債銀行。','只提高單一銀行資本就能保證整個金融體系沒有共同風險。'],
'exam':['先分流動性不足與資不抵債。','安全網題一定寫出「穩定效果＋道德危險」兩面。','監理題分個體審慎與總體審慎，再判斷政策目標。'],
'checks':['存款保險為何能降低擠兌，也可能提高道德危險？','最後貸款者的核心適用情境是什麼？','個體審慎與總體審慎監理有何不同？'],
'figure':('金融安全網與道德危險',['資本／流動性','存款保險','最後貸款者','系統穩定'])
},
{
'id':'ch09','title':'準備貨幣、銀行準備與存款創造','slug':'deposit-creation',
'problem':'銀行放款為何能同時創造存款？準備貨幣又和銀行準備有何不同？關鍵是把中央銀行貨幣與銀行存款分成不同負債層次。',
'intuition':['準備貨幣（reserve money／base money，常稱貨幣基數）主要由流通中通貨與銀行在中央銀行的準備構成。銀行準備只是準備貨幣的一部分，不是另一個完全獨立的貨幣基數。','銀行核准新放款時，可以在自身帳上同時增加放款資產與借款人的存款負債，這就是放款創造存款。但借款人把存款轉到別家銀行後，原銀行需透過跨行清算移轉準備；因此資本、流動性、信用風險、資金成本、監理與信用需求都會限制放款。'],
'definitions':[('準備貨幣','中央銀行層級的基礎貨幣，包含流通中通貨與銀行準備等。'),('銀行準備','商業銀行持有的現金及／或在中央銀行的可用準備餘額，依制度定義而定。'),('放款創造存款','銀行新放款在會計上同時形成對借款人的資產與對客戶的存款負債。'),('跨行清算','不同銀行客戶支付後，銀行間以中央銀行準備或其他合格結算資產完成最終資金移轉。'),('個別銀行限制','單一銀行不能把全體銀行體系的存款擴張邏輯當成自己不受清算與資金約束的能力。')],
'formulas':[('B=C+R','簡化準備貨幣恆等：C 為流通中通貨，R 為銀行準備。'),('\Delta貸款=+L,\quad\Delta存款=+L','同一銀行核貸並入帳時的最簡資產負債表效果；後續支付會引發準備移轉。')],
'example':['銀行核准 NT$100 萬新貸款並存入借款人帳戶：資產「放款」+100 萬，負債「存款」+100 萬，資產負債表仍平衡。','借款人若把 80 萬轉給另一家銀行客戶，原銀行會流出相應清算資金；因此放款並不是不需要流動性。','解題時要分成「核貸當下」與「跨行支付後」兩個時點。'],
'traps':['銀行可以無限制憑空放款。','把新存款形成誤寫成銀行先把既有某位存款人的錢直接交給借款人。','把準備貨幣與廣義貨幣 M2 視為固定一比一。'],
'exam':['先畫銀行 A=L+E 的雙邊變動。','再問支付是否跨行，若跨行就補準備清算。','最後列資本、流動性、風險、資金成本與信用需求限制。'],
'checks':['新放款入帳時，銀行哪個資產與哪個負債同時增加？','借款人跨行轉帳後，原銀行最直接面臨哪種結算需求？','準備貨幣與 M2 為何不是同一概念？'],
'figure':('放款創造存款與清算',['核准放款','形成存款','跨行支付','準備清算'])
},
{
'id':'ch10','title':'貨幣乘數與貨幣供給','slug':'money-multiplier',
'problem':'教科書常寫 1/rr，但現實貨幣供給為何不會按固定倍數機械擴張？因為通貨持有、超額準備、資本、借款需求與銀行行為都會變。',
'intuition':['簡單存款乘數是假設性基準：沒有通貨外流、銀行不持有超額準備、每輪存款都依固定準備率繼續放款，而且信用需求足夠。在這些條件下才有 1/rr。','較一般的貨幣乘數把通貨—存款比率 c 與超額準備率 e 納入。即使公式算得出一個倍數，c、e、銀行風險偏好與信用需求也會隨情勢變化，因此不是央行可以永遠固定設定的常數。'],
'definitions':[('簡單存款乘數','嚴格假設下，初始準備增加可支持的存款擴張相對倍數 1/rr。'),('法定／必要準備率 rr','銀行依制度需相對特定存款持有的準備比例；實際制度依國家與時期而異。'),('超額準備率 e','銀行持有超過最低需求的準備，相對存款的比例。'),('通貨—存款比率 c','民眾持有通貨相對存款的比例。'),('信用需求','具意願且符合授信條件的借款需求，是實際信用擴張的重要行為條件。')],
'formulas':[('簡單存款乘數=1/rr','僅在沒有通貨外流、沒有超額準備等嚴格條件下成立。'),('m=(1+c)/(rr+e+c)','一般化的示意貨幣乘數；c、e、rr 的定義與制度要一致。'),('M=mB','會計／行為分解式；m 並非固定常數，因此不可把 B 的變動機械翻成 M。')],
'example':['若 rr=10%，且假設沒有通貨外流與超額準備，簡單存款乘數為 1/0.10=10。','若 c=0.2、e=0.05、rr=0.10，則 m=(1+0.2)/(0.10+0.05+0.20)=1.2/0.35≈3.43。','這兩題都是模型計算，不代表現實中準備增加 NT$1 就保證 M2 增加固定倍數；資本與信用需求仍會影響放款。'],
'traps':['貨幣乘數在現實中永遠等於 1/rr。','把銀行持有更多超額準備誤判為貨幣乘數上升。','忽略通貨外流、資本與信用需求，只看準備率就預測實際 M2。'],
'exam':['看到 1/rr 先找題目是否明示簡化假設。','一般乘數題依序找 c、e、rr，分子分母不要顛倒。','政策題若問實際貨幣供給，必須補「乘數是內生且可變」的限制。'],
'checks':['rr 上升時，其他條件固定下簡單存款乘數如何變？','c 上升代表民眾偏好更多通貨，通常如何影響一般乘數？','為何大量銀行準備不一定轉成同倍數貸款？'],
'figure':('從準備到廣義貨幣',['準備貨幣 B','銀行行為','公眾持幣','廣義貨幣 M'])
},
{
'id':'ch11','title':'貨幣需求與實質貨幣餘額','slug':'money-demand',
'problem':'人們為何願意持有幾乎不生利息的交易性貨幣？貨幣需求反映交易便利、風險與持有其他資產的機會成本。',
'intuition':['收入與交易量提高時，通常需要更多交易餘額；利率提高時，持有低收益貨幣的機會成本上升，因此貨幣需求通常下降。重要的是區分名目貨幣 M 與實質購買力 M/P。','古典數量理論常從 MV=PY 看貨幣與名目支出的長期關係；Keynes 流動性偏好強調利率與資產選擇。現代觀點則把貨幣視為資產組合的一部分。'],
'definitions':[('貨幣需求','家戶與企業希望持有的貨幣餘額，而非希望借多少錢。'),('實質貨幣餘額','M/P，表示名目貨幣可購買的實質商品與服務量。'),('交易動機','為日常支付與收支不同步保留貨幣。'),('預防動機','為不確定支出保留高流動性資產。'),('投機／資產配置動機','依利率、風險與預期在貨幣和其他資產間配置。')],
'formulas':[('M/P=L(Y,i)','實質貨幣需求通常隨實質所得 Y 增加、隨持有貨幣的機會成本 i 增加而下降。'),('MV=PY','數量方程式為恆等關係；要推出因果結論還需對 V、Y 與貨幣供給機制作額外假設。')],
'example':['若名目貨幣餘額為 NT$200 萬、價格指數相對基期為 1.25，實質貨幣餘額為 200/1.25=NT$160 萬（以基期購買力表示）。','若市場利率上升，其他條件固定下，持有零息交易餘額的機會成本增加，貨幣需求可能下降。','MV=PY 題要先分它是恆等式還是搭配「V 穩定、Y 由實質因素決定」等額外假設。'],
'traps':['把貨幣需求理解成借貸需求。','價格上升時仍把同一名目 M 當成同一實質購買力。','由 MV=PY 直接斷言任何期間貨幣成長都一比一造成通膨。'],
'exam':['先判斷問名目還是實質貨幣。','比較利率效果時寫出機會成本。','數量方程式題把恆等式與行為假設分兩層回答。'],
'checks':['收入增加通常如何影響交易性貨幣需求？','名目 M 不變、P 上升時 M/P 如何變？','V 不穩定時，單靠 M 能否精準預測 PY？'],
'figure':('貨幣需求的三個來源',['交易需求','預防需求','資產配置','實質餘額 M/P'])
},
{
'id':'ch12','title':'中央銀行資產負債表與角色','slug':'central-bank-balance-sheet',
'problem':'中央銀行買賣資產時，為何會改變銀行準備與準備貨幣？理解政策操作前，先看中央銀行資產負債表。',
'intuition':['中央銀行資產可能包括政府證券、對金融機構融通與外匯資產；重要負債包含流通中通貨與銀行準備。當央行向銀行或市場買入資產並以準備金支付，通常會擴張中央銀行負債端的準備。','中央銀行同時負責貨幣政策、支付清算與金融穩定相關功能，但每個國家的法定目標、治理與工具配置不同。分析時應把「央行可以創造自身負債」和「央行可以無成本解決所有實質資源問題」分開。'],
'definitions':[('中央銀行資產負債表','記錄央行持有資產與發行的通貨、銀行準備等負債。'),('準備金','商業銀行在中央銀行的清算與流動性資產。'),('公開市場買進','央行買入合格資產並支付準備，通常使準備貨幣增加。'),('貼現／融通','央行依制度向金融機構提供有擔保或符合條件的資金。'),('央行獨立性','在法定授權與問責下，政策決策免受短期政治干預的制度安排程度。')],
'formulas':[('央行資產=央行負債+資本','與一般資產負債表同樣遵守會計恆等。'),('\Delta央行資產=+X\Rightarrow\Delta準備或其他央行負債\approx+X','簡化公開市場買進例；實際負債組成取決於交易對手與支付。')],
'example':['央行向銀行買進 NT$50 億證券，簡化情況下央行資產「證券」+50 億，負債「銀行準備」+50 億，因此準備貨幣增加 NT$50 億。','若民眾之後把存款換成現金，央行負債組成會由銀行準備轉向流通中通貨，但不必代表央行總負債同額再增加。','因此「準備增加」與「廣義貨幣必然增加同額或固定倍數」仍是不同命題。'],
'traps':['把央行買進證券當成政府財政支出。','把銀行準備列成央行資產；對央行而言它是負債。','認為央行資產負債表擴張必然造成同比例即期通膨。'],
'exam':['OMO 題先寫央行雙邊分錄。','再追商業銀行準備與資產變化。','最後才討論利率、信貸與支出的傳遞，不跨步。'],
'checks':['央行買進證券時，央行哪個資產與哪個負債通常上升？','銀行把準備換成現金時，準備貨幣總量必然變嗎？','央行資產負債表擴張與財政赤字是否同一概念？'],
'figure':('中央銀行資產負債表',['政府／外匯資產','金融機構融通','流通中通貨','銀行準備'])
},
{
'id':'ch13','title':'貨幣政策工具與操作架構','slug':'policy-operating-framework',
'problem':'中央銀行宣布政策利率後，如何讓市場隔夜利率與金融條件靠近目標？答案在公開市場操作、準備制度、融通工具與操作架構。',
'intuition':['現代央行常先選一個短期政策利率或操作目標，再用資產買賣、存放款工具與準備制度管理短期資金供需。走廊型制度用上下限利率約束市場利率；準備充裕的地板型制度則可用準備金付息等機制把市場利率托在政策底部附近。','台灣中央銀行公開列示的工具包括準備金制度、貼現窗口制度、公開市場操作、金融機構轉存款與選擇性信用管理；公開市場操作中可見央行存單等工具。制度會調整，因此本書不把當期利率或準備率寫死。'],
'definitions':[('公開市場操作','中央銀行買賣證券或使用市場工具調節銀行體系流動性與短期利率。'),('央行存單','中央銀行可用來吸收市場流動性的負債工具之一。'),('貼現窗口','符合條件的金融機構向中央銀行取得流動性融通的機制。'),('利率走廊','以央行借出與吸收資金利率形成市場短率上下邊界的操作框架。'),('地板型制度','準備充裕下，以準備金報酬或其他吸收工具把市場短率錨定在政策底部附近的框架。')],
'formulas':[('政策工具\rightarrow操作目標\rightarrow市場利率','先區分央行直接控制的工具與希望影響的市場價格。'),('\Delta流動性=注入-吸收','簡化操作帳；央行買進資產常注入準備，發行央行存單等可吸收流動性。')],
'example':['若短期市場流動性過多、隔夜利率低於央行希望區間，央行可透過適當吸收工具降低準備供給壓力。','相反地，市場短缺流動性時，可透過買進資產或融通工具注入準備。','走廊與地板型只是不同操作架構；不能把其中一種寫成所有央行永遠唯一的制度。'],
'traps':['把「政策利率」與所有市場利率視為完全相同。','把央行存單誤認為一般企業商業本票。','背某一時點利率數值並當成永久制度定義。'],
'exam':['先分工具、操作目標與最終目標。','看到準備充裕／稀缺線索，再判斷走廊或地板型直覺。','台灣制度題使用央行最新官方用語，不靠過期講義數字。'],
'checks':['央行發行存單通常偏向注入還是吸收流動性？','走廊上下限由哪些央行工具概念形成？','為何政策利率變動不代表所有放款利率同幅同步變動？'],
'figure':('政策操作架構',['央行工具','銀行準備','隔夜市場利率','政策利率錨'])
},
{
'id':'ch14','title':'貨幣政策傳遞機制','slug':'policy-transmission',
'problem':'政策利率只是一個很短期的價格，為何能影響消費、投資、資產價格與通膨？中間要經過多條傳遞管道，而且強弱取決於金融體系狀態。',
'intuition':['利率管道從短期政策利率影響市場利率、融資成本與跨期支出；銀行放款與信用管道強調金融中介資產負債表；資產價格與匯率管道改變財富、抵押品與外需；預期管道則透過央行承諾與可信度影響今天的長率與定價。','傳遞不是按鈕。銀行資本受損、風險溢酬飆升、借款需求疲弱或市場功能失靈時，同一政策動作的效果會不同，因此政策結論須附制度與金融條件。'],
'definitions':[('貨幣政策傳遞','中央銀行工具經金融價格、資產負債表與預期影響總體支出與物價的過程。'),('利率管道','政策短率影響實質融資成本與跨期消費投資。'),('銀行放款管道','銀行準備、資金成本、資本與風險承擔改變信貸供給。'),('資產負債表管道','借款人淨值與抵押品價值改變外部融資溢酬。'),('預期管道','央行溝通與可信度影響未來利率、通膨與經濟條件預期。')],
'formulas':[('實質利率\approx名目利率-預期通膨','短期支出決策常更接近對實質融資成本反應。'),('政策利率\rightarrow市場利率／信用／資產價格／匯率／預期\rightarrow支出與通膨','傳遞鏈條；中間每一步都可能有時滯與摩擦。')],
'example':['央行升息後，若銀行資金成本與市場債券殖利率上升，企業投資與耐久財支出可能減少。','若同時金融危機使信用利差飆升，市場借款成本可能比政策利率變動更大；反之銀行競爭或長率預期也可能緩衝。','因此「升息→需求下降」是條件性方向，而不是每個產業、每個借款人同幅變化。'],
'traps':['只寫政策利率變化，跳過中間金融傳遞。','把名目利率與實質利率混用而不說預期通膨。','認為銀行準備增加就足以保證新增放款。'],
'exam':['政策題至少點出兩條傳遞管道。','金融危機題優先檢查信用利差、銀行資本與市場功能。','若題目給預期通膨，先轉實質利率再判斷支出。'],
'checks':['名目利率不變但預期通膨下降時，實質利率如何變？','銀行資本受損會如何削弱放款管道？','央行溝通為何可能影響長期利率？'],
'figure':('貨幣政策多重傳遞',['政策利率','金融條件','消費與投資','產出與通膨'])
},
{
'id':'ch15','title':'貨幣、物價、通膨與 Fisher 關係','slug':'money-inflation',
'problem':'貨幣成長、物價與名目利率如何連結？長期分析要分清數量方程式、貨幣中立假說與 Fisher equation／Fisher effect。',
'intuition':['MV=PY 本身只是名目支出的會計恆等；若再假設長期實質產出主要由實質因素決定、流通速度較穩定，持續過快的貨幣成長才會與持續通膨建立較強的長期關係。','Fisher equation 是名目與實質報酬的關係式；Fisher effect 則是經濟命題：若長期實質利率大致由實質因素決定，預期通膨上升會反映在較高名目利率。等式本身不等於已證明因果。'],
'definitions':[('通膨','整體價格水準持續上升的率，而不是單一商品漲價。'),('貨幣中立','在特定長期模型中，貨幣水準變動主要影響名目量而不改變實質量的性質。'),('Fisher equation','(1+i)=(1+r)(1+π^e) 的名目、實質與預期通膨關係。'),('Fisher effect','在額外長期條件下，預期通膨變動反映在名目利率的命題。'),('鑄幣稅','政府／央行透過發行基礎貨幣取得實質資源的效果；高通膨會侵蝕貨幣持有者購買力。')],
'formulas':[('(1+i)=(1+r)(1+\pi^e)','精確 Fisher 關係。'),('i\approx r+\pi^e','利率與通膨率不高時常用近似。'),('MV=PY','搭配額外長期假設才可用來討論貨幣成長與通膨。')],
'example':['若名目利率 8%、預期通膨 3%，低通膨近似下實質利率約 5%。精確實質利率則是 1.08/1.03-1。','若長期實質利率約維持 3%，預期通膨由 2% 升至 4%，Fisher effect 的近似直覺是名目利率由約 5% 升至 7%。','這不是說每次短期通膨上升都會立即讓所有名目利率一比一上升。'],
'traps':['把 Fisher equation 本身當成預期通膨因果效果的完整證明。','由 MV=PY 直接宣稱 V、Y 永遠固定。','把相對價格一次性上漲與持續總體通膨混為一談。'],
'exam':['Fisher 題先看題目要精確式還是近似式。','貨幣與通膨題先寫額外長期假設。','名目／實質題確認使用的是實際通膨還是預期通膨。'],
'checks':['名目 8%、預期通膨 3% 時，近似實質利率是多少？','Fisher equation 與 Fisher effect 有何不同？','MV=PY 為何不能單獨證明短期貨幣與物價因果？'],
'figure':('貨幣、物價與利率',['貨幣成長','名目支出','通膨預期','名目利率'])
},
{
'id':'ch16','title':'短期產出、Phillips curve 與政策取捨','slug':'phillips-policy',
'problem':'短期內需求變化可能同時影響產出與通膨，但這種取捨受預期、供給衝擊與經濟缺口影響，不能當成永遠固定的菜單。',
'intuition':['當實際活動高於可持續水準時，工資與價格壓力可能上升；活動疲弱時則相反。Phillips curve 用一個簡化關係把通膨、預期與景氣缺口連起來。','若大家調整通膨預期，短期曲線會移動；能源等供給衝擊也可在產出疲弱時推高通膨。因此政策不能只看一個通膨數字判斷需求強弱。'],
'definitions':[('產出缺口','實際產出相對潛在產出的偏離。'),('Phillips curve','通膨與景氣鬆緊、預期及供給衝擊之間的簡化短期關係。'),('預期增廣','把預期通膨加入 Phillips curve，避免把通膨—失業關係視為永久固定。'),('供給衝擊','直接改變成本或生產能力，可能同時推升通膨並壓低產出的衝擊。'),('犧牲率','降低通膨過程中可能伴隨的累積產出或就業損失概念。')],
'formulas':[('\pi=\pi^e+\kappa x+v','x 可代表產出缺口；v 為供給衝擊。符號方向依教材定義一致。'),('實質利率\approx i-\pi^e','政策透過實質利率影響需求，再進入產出缺口與通膨。')],
'example':['若預期通膨 2%、κ=0.5、正產出缺口 2%，且供給衝擊為 0，則通膨=2%+0.5×2%=3%。','若同時出現正的成本衝擊 v，即使產出缺口不大，通膨仍可能上升。','考題若只問方向，先辨認是需求衝擊還是供給衝擊。'],
'traps':['把 Phillips curve 當成政府可永久選擇任意通膨與失業組合。','忽略預期變動。','把供給衝擊造成的通膨完全解讀成需求過熱。'],
'exam':['先寫預期，再放景氣缺口與供給衝擊。','需求衝擊與供給衝擊分開畫方向。','政策題若同時有通膨與產出目標，說明權衡與時滯。'],
'checks':['預期通膨上升、其他不變時 Phillips curve 如何移動？','負向供給衝擊可能如何同時影響通膨與產出？','產出缺口為零是否保證通膨為零？'],
'figure':('短期通膨的三個來源',['通膨預期','產出缺口','供給衝擊','實際通膨'])
},
{
'id':'ch17','title':'規則、裁量、可信度與 Taylor principle','slug':'rules-credibility',
'problem':'央行應完全照公式還是逐次裁量？貨幣政策設計的核心是可預測性、資訊使用、可信度與面對新衝擊的彈性。',
'intuition':['規則可以降低政策反覆與時間不一致，但任何簡化規則都可能漏掉金融危機或供給衝擊等資訊；裁量能回應新情勢，卻可能讓市場難以判斷反應函數。現代實務往往是有策略框架的裁量，而非兩個極端。','Taylor principle 的核心直覺是：在標準模型條件下，通膨持續高於目標時，名目政策利率上升幅度要足以讓實質利率也上升，才有抑制需求的效果。它不是所有央行依法必須照抄的固定公式。'],
'definitions':[('政策規則','把政策工具對可觀察經濟狀況的系統性反應以明確原則表示。'),('裁量','政策制定者依當期資訊與判斷調整工具，而不被單一機械公式綁定。'),('時間不一致','事前承諾最適、事後卻有誘因偏離，導致預期與可信度問題。'),('可信度','市場相信央行會依其目標與溝通採取一致行動的程度。'),('Taylor principle','標準模型中，通膨上升時名目政策利率反應超過一比一的穩定化條件直覺。')],
'formulas':[('i=r^*+\pi+0.5(\pi-\pi^*)+0.5x','教學用 Taylor 型規則示例；係數與變數不是法律規定。'),('\Delta i>\Delta\pi^e\Rightarrow\Delta r>0','在近似 Fisher 關係下，名目利率反應夠大才會提高實質利率。')],
'example':['若 r*=1%、π=4%、π*=2%、產出缺口 x=1%，示例規則給 i=1+4+0.5×2+0.5×1=6.5%。','這個 6.5% 是教學公式的計算，不代表任何真實央行在同樣資料下依法必須設定 6.5%。','考試若問規則優點，寫可預測與約束時間不一致；問缺點，寫模型誤設與非常態衝擊。'],
'traps':['Taylor rule 是所有央行依法必須遵守的公式。','把「規則」理解成利率永遠不變。','認為提高央行可信度完全不需要透明、溝通與問責。'],
'exam':['計算題先逐項代入，百分點不要轉錯。','觀念題分「反應原則」與「機械公式」。','時間不一致題一定把事前承諾與事後誘因分開。'],
'checks':['Taylor principle 為何要求名目利率對通膨超過一比一反應？','規則與裁量各有什麼主要優缺點？','可信度如何影響政策傳遞？'],
'figure':('政策框架與可信度',['目標','反應原則','政策溝通','市場預期'])
},
{
'id':'ch18','title':'有效下限、QE、前瞻指引與危機工具','slug':'unconventional-policy',
'problem':'當短期政策利率已很低、金融市場又受損時，中央銀行還有哪些工具？非常規政策主要改變資產負債表、期限風險、信用條件與預期。',
'intuition':['有效下限使傳統降息空間變小，但不代表所有貨幣政策永久無效。央行可以買進較長天期資產、提供期限較長流動性、調整抵押品與透過前瞻指引影響未來短率預期。','量化寬鬆（QE）是中央銀行資產負債表操作，不是財政支出，也不等於直接把同額現金交給家庭。買進資產往往增加銀行準備，但不代表銀行一定新增同額放款，更不代表廣義貨幣以固定乘數增加。'],
'definitions':[('有效下限（ELB）','名目短期政策利率難以再大幅降低的實務下限。'),('量化寬鬆（QE）','央行大規模買進較長天期或特定資產，以影響期限溢酬、金融條件與預期。'),('前瞻指引','央行對未來政策反應或利率路徑提供資訊，以影響今日預期與長率。'),('流動性工具','危機時向市場或金融機構提供融通，緩解市場功能與短期資金壓力。'),('資產負債表政策','透過央行資產規模或組成改變金融條件的政策。')],
'formulas':[('長期利率\approx未來短率預期平均+期限溢酬','前瞻指引主要影響前項，QE 也可能透過期限溢酬與資產替代影響後項。'),('央行買進資產\Rightarrow央行資產\uparrow,\ 銀行準備通常\uparrow','會計效果不等同最終信貸與支出的固定倍數效果。')],
'example':['央行以 NT$100 億準備買進長債，銀行體系準備可能增加 NT$100 億；但若銀行缺乏合格借款需求或受資本約束，不代表銀行一定新增 NT$100 億甚至固定倍數放款。','前瞻指引若可信，市場可能在今日就調整對未來短率的預期，進而影響長期債券殖利率。','危機工具要分「修復市場流動性」與「刺激總需求」兩種目的。'],
'traps':['QE 必然使 M2 等比例增加。','流動性陷阱使所有貨幣政策永久無效。','把央行資產購買與政府直接增加公共支出視為同一政策。'],
'exam':['先判斷問題是 ELB 還是市場功能失靈。','QE 題分會計效果、金融市場效果與最終總體效果三層。','前瞻指引題必須提可信度與市場預期。'],
'checks':['QE 增加銀行準備為何不保證新增放款？','前瞻指引如何影響長期利率？','ELB 是否等於央行完全沒有政策工具？'],
'figure':('非常規政策的三條路',['資產購買','流動性工具','前瞻指引','金融條件'])
},
{
'id':'ch19','title':'匯率、外匯干預與開放經濟貨幣政策','slug':'open-economy-money',
'problem':'利率政策如何跨越國界影響匯率與資本流動？先固定報價方式，再分析外匯干預、沖銷與不可能三角。',
'intuition':['本書固定使用 E=NT$/US$，即 1 美元需要多少新臺幣。E 上升代表美元變貴、新臺幣貶值；E 下降代表新臺幣升值。沒有先固定報價方式，就不能只說「匯率上升」判斷本幣升貶。','央行買賣外匯會改變外匯資產與本國貨幣負債。若同時用公開市場工具抵消對銀行準備的影響，稱為沖銷。不可能三角說明在資本高度流動下，固定匯率、獨立貨幣政策與自由資本流動三者不能同時完全達成。'],
'definitions':[('名目匯率 E','本書固定 E=NT$/US$；是每 1 美元所需的新臺幣。'),('本幣貶值','在 E=NT$/US$ 下，E 上升表示新臺幣相對美元價值下降。'),('外匯干預','中央銀行在外匯市場買賣外幣資產以影響市場與自身資產負債表。'),('沖銷（sterilization）','以另一項國內貨幣操作抵消外匯干預對銀行準備或準備貨幣的影響。'),('不可能三角','固定匯率、獨立貨幣政策與資本自由流動三項政策目標無法同時完全實現。')],
'formulas':[('E=NT\$/US\$','直接報價：E↑＝新臺幣貶值；E↓＝新臺幣升值。'),('新臺幣成本=美元金額\times E','固定報價下的換算。'),('未沖銷外匯買進\Rightarrow外匯資產\uparrow,\ 準備通常\uparrow','若另用國內工具吸收準備，則為沖銷干預。')],
'example':['進口商要支付 US$10,000。當 E=31 時需 NT$310,000；若 E 升到 32，需 NT$320,000，表示新臺幣貶值。','若央行買進外匯並釋出新臺幣，銀行準備可能上升；若同時發行工具吸收同額流動性，則可沖銷其準備效果。','不可能三角題先確認資本流動程度與匯率制度，再談貨幣政策自主性。'],
'traps':['任何匯率上升都代表本幣升值。','把外匯干預與沖銷當成同一動作。','認為不可能三角代表三個目標任何兩個都完全不能選。'],
'exam':['第一行先寫報價 E=NT$/US$。','再判斷 E 上升／下降對新臺幣方向。','制度題用三角形逐一勾選固定匯率、資本流動與政策自主。'],
'checks':['E 從 31 升到 32，依本書報價新臺幣升值還是貶值？','沖銷外匯買進要抵消哪一個貨幣面效果？','高度資本流動且固定匯率時，貨幣政策自主性受到什麼限制？'],
'figure':('開放經濟貨幣政策',['利率差異','資本流動','匯率 E','央行干預'])
},
]
